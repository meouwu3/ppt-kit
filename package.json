{
  "name": "ppt-kit",
  "private": true,
  "version": "0.1.0",
  "description": "Web-native presentations with fast PNG, PDF, and PPTX export",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "lint": "oxlint .",
    "test": "vitest run --dir tests",
    "check": "pnpm lint && pnpm test && pnpm build",
    "preview": "vite preview --host 127.0.0.1",
    "export": "node scripts/export.mjs",
    "create-ppt": "node skills/ppt/scripts/create-ppt.mjs",
    "sync-skill": "node scripts/sync-skill-template.mjs"
  },
  "dependencies": {
    "@number-flow/react": "^0.6.1",
    "lucide-react": "^0.545.0",
    "motion": "^12.42.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jszip": "^3.10.1",
    "oxlint": "^1.71.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.61.1",
    "pptxgenjs": "^4.0.1",
    "tailwindcss": "^4.1.18",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.11"
  }
}
